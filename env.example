# Rename this file to .env and fill it in. Never share it.
MODE=auto            # auto = agent logs in & searches | attach = you search, agent takes over
HEADLESS=0           # 0 = visible browser (use while testing), 1 = hidden

PORTAL_USER=
PORTAL_PASS=

ANTHROPIC_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=car-auction-agent
